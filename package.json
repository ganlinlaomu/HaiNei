{
  "name": "closed-community-pwa",
  "version": "0.1.198",
  "releaseSummary": "私信和帖子里的视频卡片直接显示缩略图，点一下就播放",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/patch-trystero-nostr.js",
    "dev": "vite",
    "build": "node scripts/update-app-version.js && node scripts/update-sw-version.js && node scripts/generate-ebook-dictionary.mjs && node scripts/generate-aozora-catalog.mjs && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit && tsc -p worker/tsconfig.json",
    "deploy:cf:pages": "npm run build && node scripts/deploy-cloudflare-pages.js",
    "build:verify": "node scripts/generate-ebook-dictionary.mjs && node scripts/generate-aozora-catalog.mjs && vite build",
    "dictionary:generate": "node scripts/generate-ebook-dictionary.mjs",
    "aozora:generate": "node scripts/generate-aozora-catalog.mjs"
  },
  "dependencies": {
    "@noble/ciphers": "0.5.3",
    "@noble/hashes": "1.3.1",
    "@zxing/library": "0.21.3",
    "dexie": "^3.2.2",
    "nostr-tools": "2.18.2",
    "pinia": "^2.1.3",
    "qrcode-generator": "2.0.4",
    "trystero": "0.26.0",
    "vue": "^3.3.4",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.0.0",
    "@vue/test-utils": "^2.5.1",
    "fake-indexeddb": "^6.0.1",
    "happy-dom": "^21.0.4",
    "typescript": "^5.4.2",
    "vite": "^5.0.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^2.2.12",
    "wrangler": "4.151.2"
  }
}
